# Copy to .env to override defaults.

# Claude runs on your Claude subscription through the Claude Code CLI, with no API key.
# Install Claude Code and sign in once: run `claude`, then /login.

# Voice (Edge neural TTS). Default: English with a German accent.
# Other options: de-DE-SeraphinaMultilingualNeural (female), en-GB-RyanNeural (British)
RUDI_TTS_VOICE=de-DE-FlorianMultilingualNeural
# RUDI_TTS_RATE=-5%
# RUDI_TTS_PITCH=-2Hz
